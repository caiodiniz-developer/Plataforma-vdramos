# Frontend (públicas por design; proteção é feita por RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge Functions / scripts locais (NUNCA no frontend, NUNCA commitar valores reais)
SUPABASE_SERVICE_ROLE_KEY=

# Usuários de exemplo (npm run usuarios:exemplo). Preencha só no .env local.
SUPABASE_URL=
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=
ALUNO_NOME=
ALUNO_SENHA=

# Senha do banco do projeto Supabase (só para a CLI: db push)
SUPABASE_DB_PASSWORD=

# Envio de e-mail (respostas de atividade para o professor e avisos para quem consentiu).
# NÃO vão neste arquivo: são segredos do projeto Supabase, gravados com
#   supabase secrets set RESEND_API_KEY=... "EMAIL_REMETENTE=Nome <avisos@dominio>"
# Opcionais: EMAIL_DO_PROFESSOR (destino das respostas) e ENDERECO_DO_SITE.
